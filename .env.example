# ── Supabase (required) ──────────────────────────────────────────────
# Found in Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Never expose to the browser.
# Used only inside server actions / API routes (e.g. admin operations).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Delivery defaults (also editable live from /admin/settings) ───────
NEXT_PUBLIC_DELIVERY_INSIDE_DHAKA=80
NEXT_PUBLIC_DELIVERY_OUTSIDE_DHAKA=130
